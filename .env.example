# =============================================================================
# B-Snap Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# DO NOT commit .env to version control!
# 
# Documentation: https://docs.b-snap.com/configuration
# =============================================================================

# =============================================================================
# 1. CORE APPLICATION SETTINGS (Required)
# =============================================================================

# Secret key for session management, CSRF protection, and signed tokens
# CRITICAL: Change this in production! Generate with: openssl rand -hex 32
# Used in: app/main.py, app/routes/auth.py, app/routes/snapshots.py
SECRET_KEY=your-very-secret-key-change-this-in-production

# Encryption key for AES-256-GCM encryption of sensitive data (camera passwords)
# CRITICAL: Keep this key secure and backed up! Loss = loss of camera password access
# Generate with: openssl rand -hex 32
# Used in: app/utils/encryption.py, app/jobs/audit_archive.py
ENCRYPTION_KEY=your-encryption-key-32-bytes-hex-change-in-production

# Application environment: development, testing, production
# Affects: Cookie security settings, debug mode, error handling
# Used in: app/main.py, app/routes/auth.py, app/utils/remember_me.py
ENVIRONMENT=development

# Database connection URL
# Format: postgresql+psycopg2://user:password@host:port/database
# Used in: app/db/database.py, app/ws/routes.py, app/ws/notifier.py
DATABASE_URL=postgresql+psycopg2://bsnap_user:bsnap_pass@localhost:5432/bsnap_db

# Docker Compose PostgreSQL initialization (required when using bundled PostgreSQL)
# Match these values and password with DATABASE_URL; Docker hostname is postgres.
# Local Python development connects to localhost and POSTGRES_PORT instead.
POSTGRES_DB=bsnap_db
POSTGRES_USER=bsnap_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional pgAdmin: docker compose --profile admin up -d pgadmin
# Leave password empty unless enabling pgAdmin; never use the application password.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Legacy SQLite importer in docker-compose-build.yml only (not normal deployment).
# Set a PostgreSQL URL explicitly when enabling its migrate profile.
# PGLOADER_TARGET_URL=

# =============================================================================
# 2. SESSION & AUTHENTICATION SETTINGS
# =============================================================================

# Session max age in seconds (default: 86400 = 24 hours)
# MED-001: Aligned with token expiration for security
# For CCTV 24/7 monitoring: Use Remember Me feature instead of extending this
# Used in: app/routes/auth.py, app/middleware/auth_and_setup.py
SESSION_MAX_AGE_SECONDS=86400

# Maximum concurrent web sessions per user (default: 1)
# Set higher if user needs multiple browser/device sessions
# Used in: app/routes/auth.py
MAX_WEB_SESSIONS=1

# =============================================================================
# 3. SECURITY SETTINGS
# =============================================================================

# Trusted hosts for CORS (comma-separated)
# Use "*" for development, specific domains for production
# Example: "b-snap.company.com,192.168.1.100"
# Used in: app/main.py
TRUSTED_HOSTS=*

# =============================================================================
# 4. EMAIL CONFIGURATION (SMTP)
# =============================================================================

# SMTP server settings for email notifications
# Database settings take priority; these values are fallbacks.
# Used in: app/utils/smtp_config.py
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Security mode: starttls, ssl_tls, none
SMTP_SECURITY=starttls

# Email sender configuration
# Used in: app/utils/smtp_config.py
EMAIL_FROM=noreply@yourdomain.com
EMAIL_CC=

# =============================================================================
# 5. STORAGE & PATHS
# =============================================================================

# Log directory path
# Used in: app/core/logging_config.py
LOG_DIR=./logs

# Alembic configuration file path
# Used in: app/db/migrate.py
ALEMBIC_INI_PATH=./alembic.ini

# =============================================================================
# 6. CAMERA & MONITORING SETTINGS
# =============================================================================

# Threshold for offline alerts (default: 1800 = 30 minutes)
# Camera considered offline after this many seconds of no response
# Used in: app/utils/healthcheck.py
OFFLINE_ALERT_THRESHOLD_SECONDS=1800

# GoWA outbound delivery limits
GOWA_SEND_TIMEOUT_SECONDS=10
GOWA_SEND_RETRIES=2

# WhatsApp webhook blocking-operation thread pools (per web worker process)
WA_CAMERA_THREAD_WORKERS=4
WA_GATEWAY_THREAD_WORKERS=8

# =============================================================================
# 7. LOGGING CONFIGURATION
# =============================================================================

# Log via gunicorn (set to 0 for direct logging)
BSNAP_LOG_VIA_GUNICORN=1

# Debug mode for logging
APP_DEBUG=0

# =============================================================================
# 8. SERVER & PERFORMANCE
# =============================================================================

# Number of workers for gunicorn (default: 2, production: 4+)
WORKERS=2

# Server port
PORT=8080

# Server bind address
BIND=0.0.0.0:8080

# Worker timeout in seconds
TIMEOUT=60

# Keep-alive timeout in seconds
KEEPALIVE=2

# =============================================================================
# 9. PROCESS TIMEZONE
# =============================================================================

# Process timezone (where supported by the OS/runtime).
# Application/report/scheduler timezone uses the database setting `timezone`.
TZ=Asia/Singapore

# =============================================================================
# 10. DATABASE POOL SETTINGS
# =============================================================================

# Database pool size for native processes (unset default: 20)
DB_POOL_SIZE=5

# Database max overflow (default: 10)
DB_MAX_OVERFLOW=10

# =============================================================================
# 11. CAPTURE, RECORDING & AUDIT
# =============================================================================

# Hard deadline per scheduled camera, including discovery/capture/metadata (10-600s).
# Set on the scheduler service; queued cameras receive a fresh budget on execution.
SNAPSHOT_JOB_CAMERA_TIMEOUT=90
# Shared filesystem directory for OS-owned camera locks. All workers must agree.
# SNAPSHOT_LOCK_DIR=/tmp/shared/locks
# Native recording mounts (Linux only; disabled by default)
BSNAP_RECORD_MOUNTS_ENABLED=false
# Required literal-IP/CIDR allowlist; prefer individual storage IPs (/32 or /128).
BSNAP_RECORD_MOUNT_ALLOWED_NETWORKS=
# AUTH_SYS is unencrypted and trusts client UID/GID. Leave false unless storage
# is on an isolated trusted network with server export/firewall restrictions.
BSNAP_RECORD_NFS_ALLOW_SYS=false

# Audit archives use a separate stable Fernet key, shared by web/scheduler.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only when archiving; back up securely and retain keys for existing archives.
AUDIT_ARCHIVE_KEY=

# Filesystem capacity monitored by scheduler (default: project static/snapshots).
# Set an existing absolute path when recordings use a different storage device.
# STORAGE_MONITOR_PATH=/app/static/snapshots

# Shared Docker image for web, scheduler, notifier and migration.
# Override to use a different registry, immutable release tag, or digest.
# BSNAP_IMAGE=kpcsgt-registry.kpc.co.id/kpc-private/b-snap:v2.4.0

# Docker role budgets (tune to the host and number of cameras).
# Native/non-container processes use DB_POOL_SIZE / DB_MAX_OVERFLOW above.
WEB_CONCURRENCY=2
GRACEFUL_TIMEOUT=90
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
WEB_DB_POOL_SIZE=5
WEB_DB_MAX_OVERFLOW=5
SCHEDULER_DB_POOL_SIZE=10
SCHEDULER_DB_MAX_OVERFLOW=5
MIGRATE_DB_POOL_SIZE=2
WEB_CPUS=2.0
WEB_MEM_LIMIT=2g
WEB_STOP_GRACE_PERIOD=120s
SCHEDULER_CPUS=2.0
SCHEDULER_MEM_LIMIT=4g
SCHEDULER_STOP_GRACE_PERIOD=180s
NOTIFIER_CPUS=0.5
NOTIFIER_MEM_LIMIT=512m
NOTIFIER_STOP_GRACE_PERIOD=60s
MIGRATE_CPUS=1.0
MIGRATE_MEM_LIMIT=512m
MIGRATE_STOP_GRACE_PERIOD=60s
POSTGRES_CPUS=2.0
POSTGRES_MEM_LIMIT=2g
POSTGRES_STOP_GRACE_PERIOD=60s
PGADMIN_CPUS=1.0
PGADMIN_MEM_LIMIT=512m
PGADMIN_STOP_GRACE_PERIOD=60s
