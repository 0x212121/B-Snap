# =============================================================================
# B-Snap Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Secret key for session management and encryption
# Generate a strong random key with: openssl rand -hex 32
SECRET_KEY=your-very-secret-key-change-this-in-production

# Application environment: development, testing, production
ENVIRONMENT=development

# Debug mode (disable in production!)
DEBUG=false

# Application timezone
TZ=Asia/Singapore

# Number of workers for gunicorn (default: 2, production: 4+)
WORKERS=2

# Server port (default: 8080)
PORT=8080

# Server bind address (default: 0.0.0.0)
BIND=0.0.0.0:8080

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection URL
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://bsnap_user:bsnap_pass@localhost:5432/bsnap_db

# SQLite fallback (for development/testing only)
# DATABASE_URL=sqlite:///./data.db

# Database pool size (default: 5)
DB_POOL_SIZE=5

# Database max overflow (default: 10)
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Redis / Cache (Optional - for future caching features)
# -----------------------------------------------------------------------------

# Redis URL for caching and session storage
# REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 300 = 5 minutes)
# CACHE_TTL=300

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------

# Trusted hosts for CORS (comma-separated)
# Use "*" for development, specific domains for production
TRUSTED_HOSTS=*

# Session cookie max age in seconds (default: 3600 = 1 hour)
SESSION_MAX_AGE=3600

# CORS origins (comma-separated, for API access)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting (requests per minute)
# RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Email Configuration (for notifications)
# -----------------------------------------------------------------------------

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false

# Default sender email
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=B-Snap System

# -----------------------------------------------------------------------------
# Snapshot & Storage Settings
# -----------------------------------------------------------------------------

# Snapshot storage path (relative to project root)
SNAPSHOT_PATH=./static/snapshots

# Video storage path
VIDEO_PATH=./static/videos

# Max snapshot age in days (auto-cleanup, default: 30)
MAX_SNAPSHOT_AGE_DAYS=30

# Max video age in days (auto-cleanup, default: 7)
MAX_VIDEO_AGE_DAYS=7

# Storage threshold percentage for warnings (default: 85)
STORAGE_WARNING_THRESHOLD=85

# Storage threshold percentage for critical (default: 95)
STORAGE_CRITICAL_THRESHOLD=95

# Max snapshot file size in MB (default: 50)
MAX_SNAPSHOT_SIZE_MB=50

# -----------------------------------------------------------------------------
# Camera Settings
# -----------------------------------------------------------------------------

# Default snapshot timeout in seconds (default: 10)
CAMERA_TIMEOUT=10

# Max concurrent snapshot workers (default: 5)
SNAPSHOT_WORKERS=5

# Health check interval in seconds (default: 60)
HEALTH_CHECK_INTERVAL=60

# ONVIF default port
ONVIF_PORT=80

# RTSP default port
RTSP_PORT=554

# -----------------------------------------------------------------------------
# Scheduler Settings
# -----------------------------------------------------------------------------

# Enable scheduled snapshots
SCHEDULER_ENABLED=true

# Default snapshot interval in minutes (default: 30)
DEFAULT_SNAPSHOT_INTERVAL=30

# Scheduler timezone
SCHEDULER_TZ=Asia/Singapore

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json, text
LOG_FORMAT=text

# Log to file (in addition to console)
LOG_TO_FILE=true

# Log file path
LOG_FILE_PATH=./logs/app.log

# Log rotation: daily, size
LOG_ROTATION=daily

# Max log file size in MB (if rotation=size)
LOG_MAX_SIZE_MB=10

# Max log file backups to keep
LOG_MAX_BACKUPS=7

# Log via gunicorn (set to 0 for direct logging)
BSNAP_LOG_VIA_GUNICORN=1

# Debug mode for logging
APP_DEBUG=0

# -----------------------------------------------------------------------------
# Gunicorn Settings
# -----------------------------------------------------------------------------

# Gunicorn log level
GUNICORN_LOGLEVEL=info

# Worker class (recommended: uvicorn.workers.UvicornWorker)
WORKER_CLASS=uvicorn.workers.UvicornWorker

# Worker timeout in seconds
TIMEOUT=60

# Keep-alive timeout in seconds
KEEPALIVE=2

# Worker connections (for gevent)
WORKER_CONNECTIONS=1000

# -----------------------------------------------------------------------------
# WebSocket Settings
# -----------------------------------------------------------------------------

# WebSocket ping interval in seconds
WS_PING_INTERVAL=30

# WebSocket ping timeout in seconds
WS_PING_TIMEOUT=10

# -----------------------------------------------------------------------------
# WhatsApp Integration (Optional)
# -----------------------------------------------------------------------------

# WhatsApp Business API URL
# WA_API_URL=https://graph.facebook.com/v18.0

# WhatsApp Business Phone Number ID
# WA_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp Business Access Token
# WA_ACCESS_TOKEN=your-access-token

# WhatsApp Webhook Verify Token
# WA_WEBHOOK_VERIFY_TOKEN=your-verify-token

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Google Analytics ID (optional)
# GA_TRACKING_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Development / Testing Only
# -----------------------------------------------------------------------------

# Enable hot reload (development only)
RELOAD=false

# Test database URL (for running tests)
TEST_DATABASE_URL=postgresql+psycopg2://bsnap_user:bsnap_pass@localhost:5432/bsnap_test

# Enable test mode (disables certain features)
TESTING=false
